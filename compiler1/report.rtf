\u919\'3f \u963\'3f\u951\'3f\u956\'3f\u945\'3f\u963\'3f\u953\'3f\u959\'3f\u955\'3f\u959\'3f\u947\'3f\u953\'3f\u954\'3f\u942\'3f \u945\'3f\u957\'3f\u940\'3f\u955\'3f\u965\'3f\u963\'3f\u951\'3f \u949\'3f\u943\'3f\u957\'3f\u945\'3f\u953\'3f \u964\'3f\u959\'3f \u963\'3f\u964\'3f\u940\'3f\u948\'3f\u953\'3f\u959\'3f \u960\'3f\u959\'3f\u965\'3f \u941\'3f\u961\'3f\u967\'3f\u949\'3f\u964\'3f\u945\'3f\u953\'3f \u956\'3f\u949\'3f\u964\'3f\u940\'3f \u964\'3f\u951\'3f \u963\'3f\u965\'3f\u957\'3f\u964\'3f\u945\'3f\u954\'3f\u964\'3f\u953\'3f\u954\'3f\u942\'3f \u945\'3f\u957\'3f\u940\'3f\u955\'3f\u965\'3f\u963\'3f\u951\'3f \u954\'3f\u945\'3f\u953\'3f \u948\'3f\u953\'3f\u945\'3f\u963\'3f\u966\'3f\u945\'3f\u955\'3f\u943\'3f\u950\'3f\u949\'3f\u953\'3f \u972\'3f\u964\'3f\u953\'3f \u959\'3f\u953\'3f \u948\'3f\u959\'3f\u956\'3f\u941\'3f\u962\'3f \u954\'3f\u945\'3f\u953\'3f \u959\'3f\u953\'3f \u949\'3f\u957\'3f\u964\'3f\u959\'3f\u955\'3f\u941\'3f\u962\'3f \u964\'3f\u959\'3f\u965\'3f \u960\'3f\u961\'3f\u959\'3f\u947\'3f\u961\'3f\u940\'3f\u956\'3f\u956\'3f\u945\'3f\u964\'3f\u959\'3f\u962\'3f \u941\'3f\u967\'3f\u959\'3f\u965\'3f\u957\'3f \u957\'3f\u972\'3f\u951\'3f\u956\'3f\u945\'3f \u963\'3f\u973\'3f\u956\'3f\u966\'3f\u969\'3f\u957\'3f\u945\'3f \u956\'3f\u949\'3f \u964\'3f\u959\'3f\u965\'3f\u962\'3f \u954\'3f\u945\'3f\u957\'3f\u972\'3f\u957\'3f\u949\'3f\u962\'3f \u964\'3f\u951\'3f\u962\'3f \u947\'3f\u955\'3f\u974\'3f\u963\'3f\u963\'3f\u945\'3f\u962\'3f \u960\'3f\u961\'3f\u959\'3f\u947\'3f\u961\'3f\u945\'3f\u956\'3f\u956\'3f\u945\'3f\u964\'3f\u953\'3f\u963\'3f\u956\'3f\u959\'3f\u973\'3f. \u931\'3f\u964\'3f\u959\'3f \u963\'3f\u964\'3f\u940\'3f\u948\'3f\u953\'3f\u959\'3f \u945\'3f\u965\'3f\u964\'3f\u972\'3f \u947\'3f\u943\'3f\u957\'3f\u949\'3f\u964\'3f\u945\'3f\u953\'3f \u941\'3f\u955\'3f\u949\'3f\u947\'3f\u967\'3f\u959\'3f\u962\'3f \u964\'3f\u973\'3f\u960\'3f\u969\'3f\u957\'3f, \u948\'3f\u942\'3f\u955\'3f\u969\'3f\u963\'3f\u951\'3f \u954\'3f\u945\'3f\u953\'3f \u967\'3f\u961\'3f\u942\'3f\u963\'3f\u951\'3f \u956\'3f\u949\'3f\u964\'3f\u945\'3f\u946\'3f\u955\'3f\u951\'3f\u964\'3f\u974\'3f\u957\'3f, \u954\'3f\u945\'3f\u952\'3f\u974\'3f\u962\'3f \u954\'3f\u945\'3f\u953\'3f \u959\'3f\u961\'3f\u952\'3f\u942\'3f \u945\'3f\u957\'3f\u964\'3f\u953\'3f\u963\'3f\u964\'3f\u959\'3f\u943\'3f\u967\'3f\u953\'3f\u963\'3f\u951\'3f \u956\'3f\u949\'3f\u964\'3f\u945\'3f\u958\'3f\u973\'3f \u955\'3f\u949\'3f\u953\'3f\u964\'3f\u959\'3f\u965\'3f\u961\'3f\u947\'3f\u953\'3f\u974\'3f\u957\'3f \u954\'3f\u945\'3f\u953\'3f \u960\'3f\u945\'3f\u961\'3f\u945\'3f\u956\'3f\u941\'3f\u964\'3f\u961\'3f\u969\'3f\u957\'3f. \u931\'3f\u964\'3f\u959\'3f\u957\'3f \u954\'3f\u974\'3f\u948\'3f\u953\'3f\u954\'3f\u940\'3f \u956\'3f\u959\'3f\u965\'3f, \u951\'3f \u963\'3f\u951\'3f\u956\'3f\u945\'3f\u963\'3f\u953\'3f\u959\'3f\u955\'3f\u959\'3f\u947\'3f\u953\'3f\u954\'3f\u942\'3f \u945\'3f\u957\'3f\u940\'3f\u955\'3f\u965\'3f\u963\'3f\u951\'3f \u965\'3f\u955\'3f\u959\'3f\u960\'3f\u959\'3f\u953\'3f\u949\'3f\u943\'3f\u964\'3f\u945\'3f\u953\'3f \u954\'3f\u965\'3f\u961\'3f\u943\'3f\u969\'3f\u962\'3f \u956\'3f\u941\'3f\u963\'3f\u969\'3f \u964\'3f\u959\'3f\u965\'3f \u960\'3f\u943\'3f\u957\'3f\u945\'3f\u954\'3f\u945\'3f \u963\'3f\u965\'3f\u956\'3f\u946\'3f\u972\'3f\u955\'3f\u969\'3f\u957\'3f (SymbolTable) \u954\'3f\u945\'3f\u953\'3f \u964\'3f\u969\'3f\u957\'3f \u963\'3f\u965\'3f\u957\'3f\u945\'3f\u961\'3f\u964\'3f\u942\'3f\u963\'3f\u949\'3f\u969\'3f\u957\'3f \u960\'3f\u959\'3f\u965\'3f \u964\'3f\u959\'3f\u957\'3f \u948\'3f\u953\'3f\u945\'3f\u967\'3f\u949\'3f\u953\'3f\u961\'3f\u943\'3f\u950\'3f\u959\'3f\u957\'3f\u964\'3f\u945\'3f\u953\'3f (new_symbol, addsymb, findsymb, build_symbol_table). \u927\'3f \u960\'3f\u943\'3f\u957\'3f\u945\'3f\u954\'3f\u945\'3f\u962\'3f \u963\'3f\u965\'3f\u956\'3f\u946\'3f\u972\'3f\u955\'3f\u969\'3f\u957\'3f \u945\'3f\u960\'3f\u959\'3f\u952\'3f\u951\'3f\u954\'3f\u949\'3f\u973\'3f\u949\'3f\u953\'3f \u972\'3f\u955\'3f\u949\'3f\u962\'3f \u964\'3f\u953\'3f\u962\'3f \u948\'3f\u951\'3f\u955\'3f\u969\'3f\u956\'3f\u941\'3f\u957\'3f\u949\'3f\u962\'3f \u956\'3f\u949\'3f\u964\'3f\u945\'3f\u946\'3f\u955\'3f\u951\'3f\u964\'3f\u941\'3f\u962\'3f \u954\'3f\u945\'3f\u953\'3f \u956\'3f\u949\'3f\u952\'3f\u972\'3f\u948\'3f\u959\'3f\u965\'3f\u962\'3f \u956\'3f\u945\'3f\u950\'3f\u943\'3f \u956\'3f\u949\'3f \u960\'3f\u955\'3f\u951\'3f\u961\'3f\u959\'3f\u966\'3f\u959\'3f\u961\'3f\u943\'3f\u949\'3f\u962\'3f \u972\'3f\u960\'3f\u969\'3f\u962\'3f \u964\'3f\u959\'3f \u972\'3f\u957\'3f\u959\'3f\u956\'3f\u945\'3f, \u964\'3f\u959\'3f scope, \u964\'3f\u959\'3f\u957\'3f \u964\'3f\u973\'3f\u960\'3f\u959\'3f (typos) \u954\'3f\u945\'3f\u953\'3f \u964\'3f\u951\'3f\u957\'3f \u945\'3f\u961\'3f\u967\'3f\u953\'3f\u954\'3f\u942\'3f \u964\'3f\u953\'3f\u956\'3f\u942\'3f (timi). \u927\'3f\u953\'3f \u963\'3f\u965\'3f\u957\'3f\u945\'3f\u961\'3f\u964\'3f\u942\'3f\u963\'3f\u949\'3f\u953\'3f\u962\'3f \u945\'3f\u965\'3f\u964\'3f\u941\'3f\u962\'3f \u949\'3f\u958\'3f\u945\'3f\u963\'3f\u966\'3f\u945\'3f\u955\'3f\u943\'3f\u950\'3f\u959\'3f\u965\'3f\u957\'3f \u972\'3f\u964\'3f\u953\'3f:}
