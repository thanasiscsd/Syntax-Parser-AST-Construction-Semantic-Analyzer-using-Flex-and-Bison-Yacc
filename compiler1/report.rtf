\par \pard\plain \s0\sl240\slmult1\sb0\sa0\widctlpar\hyphpar0\aspalpha\ltrpar\dbch\af7\dbch\af10\afs24\cf0\kerning1\langfe2052\alang1081\loch\f3\fs24\lang1032\sl276\slmult1\li0\ri0\lin0\rin0\fi0\sb0\sa200{\b0\rtlch \ltrch\loch\fs22\lang1032
\u919\'3f \u963\'3f\u965\'3f\u957\'3f\u940\'3f\u961\'3f\u964\'3f\u951\'3f\u963\'3f\u951\'3f build_symbol_table() \u948\'3f\u953\'3f\u945\'3f\u963\'3f\u967\'3f\u943\'3f\u950\'3f\u949\'3f\u953\'3f \u945\'3f\u957\'3f\u945\'3f\u948\'3f\u961\'3f\u959\'3f\u956\'3f\u953\'3f\u954\'3f\u940\'3f \u964\'3f\u959\'3f Abstract Syntax Tree (AST) \u954\'3f\u945\'3f\u953\'3f \u960\'3f\u961\'3f\u959\'3f\u963\'3f\u952\'3f\u941\'3f\u964\'3f\u949\'3f\u953\'3f \u954\'3f\u940\'3f\u952\'3f\u949\'3f \u948\'3f\u942\'3f\u955\'3f\u969\'3f\u963\'3f\u951\'3f \u956\'3f\u949\'3f\u964\'3f\u945\'3f\u946\'3f\u955\'3f\u951\'3f\u964\'3f\u942\'3f\u962\'3f \u942\'3f \u956\'3f\u949\'3f\u952\'3f\u972\'3f\u948\'3f\u959\'3f\u965\'3f \u963\'3f\u964\'3f\u959\'3f\u957\'3f \u960\'3f\u943\'3f\u957\'3f\u945\'3f\u954\'3f\u945\'3f \u963\'3f\u965\'3f\u956\'3f\u946\'3f\u972\'3f\u955\'3f\u969\'3f\u957\'3f. \u931\'3f\u949\'3f \u960\'3f\u949\'3f\u961\'3f\u943\'3f\u960\'3f\u964\'3f\u969\'3f\u963\'3f\u951\'3f \u948\'3f\u953\'3f\u960\'3f\u955\'3f\u942\'3f\u962\'3f \u948\'3f\u942\'3f\u955\'3f\u969\'3f\u963\'3f\u951\'3f\u962\'3f, \u949\'3f\u956\'3f\u966\'3f\u945\'3f\u957\'3f\u943\'3f\u950\'3f\u949\'3f\u964\'3f\u945\'3f\u953\'3f \u963\'3f\u966\'3f\u940\'3f\u955\'3f\u956\'3f\u945\'3f \u954\'3f\u945\'3f\u953\'3f \u964\'3f\u959\'3f \u960\'3f\u961\'3f\u972\'3f\u947\'3f\u961\'3f\u945\'3f\u956\'3f\u956\'3f\u945\'3f \u964\'3f\u949\'3f\u961\'3f\u956\'3f\u945\'3f\u964\'3f\u943\'3f\u950\'3f\u949\'3f\u964\'3f\u945\'3f\u953\'3f. \u928\'3f\u945\'3f\u961\'3f\u940\'3f\u955\'3f\u955\'3f\u951\'3f\u955\'3f\u945\'3f, \u951\'3f \u963\'3f\u965\'3f\u957\'3f\u940\'3f\u961\'3f\u964\'3f\u951\'3f\u963\'3f\u951\'3f check_undeclared_variables() \u949\'3f\u955\'3f\u941\'3f\u947\'3f\u967\'3f\u949\'3f\u953\'3f \u972\'3f\u964\'3f\u953\'3f \u954\'3f\u940\'3f\u952\'3f\u949\'3f \u956\'3f\u949\'3f\u964\'3f\u945\'3f\u946\'3f\u955\'3f\u951\'3f\u964\'3f\u942\'3f \u960\'3f\u959\'3f\u965\'3f \u967\'3f\u961\'3f\u951\'3f\u963\'3f\u953\'3f\u956\'3f\u959\'3f\u960\'3f\u959\'3f\u953\'3f\u949\'3f\u943\'3f\u964\'3f\u945\'3f\u953\'3f \u941\'3f\u967\'3f\u949\'3f\u953\'3f \u960\'3f\u961\'3f\u959\'3f\u951\'3f\u947\'3f\u959\'3f\u965\'3f\u956\'3f\u941\'3f\u957\'3f\u969\'3f\u962\'3f \u948\'3f\u951\'3f\u955\'3f\u969\'3f\u952\'3f\u949\'3f\u943\'3f \u963\'3f\u964\'3f\u959\'3f \u954\'3f\u945\'3f\u964\'3f\u940\'3f\u955\'3f\u955\'3f\u951\'3f\u955\'3f\u959\'3f scope \u954\'3f\u945\'3f\u953\'3f \u972\'3f\u964\'3f\u953\'3f \u948\'3f\u949\'3f\u957\'3f \u967\'3f\u961\'3f\u951\'3f\u963\'3f\u953\'3f\u956\'3f\u959\'3f\u960\'3f\u959\'3f\u953\'3f\u959\'3f\u973\'3f\u957\'3f\u964\'3f\u945\'3f\u953\'3f \u948\'3f\u949\'3f\u963\'3f\u956\'3f\u949\'3f\u965\'3f\u956\'3f\u941\'3f\u957\'3f\u949\'3f\u962\'3f \u955\'3f\u941\'3f\u958\'3f\u949\'3f\u953\'3f\u962\'3f \u964\'3f\u951\'3f\u962\'3f \u947\'3f\u955\'3f\u974\'3f\u963\'3f\u963\'3f\u945\'3f\u962\'3f \u969\'3f\u962\'3f \u959\'3f\u957\'3f\u972\'3f\u956\'3f\u945\'3f\u964\'3f\u945\'3f \u956\'3f\u949\'3f\u964\'3f\u945\'3f\u946\'3f\u955\'3f\u951\'3f\u964\'3f\u974\'3f\u957\'3f.}
